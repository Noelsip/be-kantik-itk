# Konfigurasi Environment - Kantin ITK
#
# Salin berkas ini menjadi `.env`, lalu sesuaikan nilainya:
#
#   cp .env.example .env
#
# Berkas `.env` tidak boleh masuk ke Git dan sudah tercantum pada .gitignore.


# Aplikasi
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Diisi true hanya bila server berada di belakang reverse proxy seperti nginx
# atau Cloudflare. Bila diisi true tanpa proxy, alamat IP klien dapat dipalsukan
# sehingga pembatasan jumlah permintaan menjadi tidak berguna.
TRUST_PROXY=false


# Database MySQL
#
# Nilai DB_* di bawah ini yang dipakai. DATABASE_URL bersifat opsional dan hanya
# dipakai bila berisi alamat mysql://, sehingga nilai milik proyek lain yang
# kebetulan ada di environment sistem tidak akan mengganggu.
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/kantin_itk
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kantin_itk
DB_CONNECTION_LIMIT=10


# Kunci akses
#
# JWT_SECRET wajib diisi, minimal 32 karakter, dan berbeda antara lingkungan
# pengembangan dengan produksi. Nilai acak dapat dibuat dengan perintah:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=kantin-itk-api


# Google SSO
#
# Client ID diperoleh dari Google Cloud Console pada menu OAuth 2.0 Client ID.
# Server hanya memeriksa identitas yang sudah diperoleh aplikasi Flutter,
# sehingga client secret tidak dibutuhkan dan tidak disimpan di sini.
#
# Nilai ini wajib diisi ketika NODE_ENV=production.
GOOGLE_CLIENT_ID=


# Otorisasi
#
# Domain email yang boleh dipakai pembeli.
ALLOWED_EMAIL_DOMAINS=student.itk.ac.id,lecture.itk.ac.id,itk.ac.id

# Daftar email yang memperoleh peran penjual, dipisahkan koma tanpa spasi.
#
# Sistem ini tidak memiliki peran admin, sehingga variabel inilah satu-satunya
# cara menetapkan penjual. Alurnya:
#
#   1. Alamat email penjual ditambahkan di sini.
#   2. Server dijalankan ulang.
#   3. Penjual masuk melalui Google seperti biasa.
#   4. Akunnya otomatis dibuat atau diperbarui dengan peran penjual.
#
# Beberapa hal yang perlu diketahui:
#   - Peran diselaraskan ulang setiap kali masuk. Menghapus sebuah alamat dari
#     daftar ini menurunkan akun tersebut menjadi pembeli pada saat masuk
#     berikutnya.
#   - Alamat pada daftar ini dikecualikan dari aturan domain kampus, sehingga
#     penjual kantin boleh memakai email di luar domain ITK.
#   - Domain email saja tidak pernah memberikan peran penjual.
#
# Contoh, sesuai akun yang dibuat oleh perintah `npm run db:seed`:
# SELLER_EMAILS=penjual.fsti@itk.ac.id,penjual.teknik@itk.ac.id,penjual.kampus@itk.ac.id
SELLER_EMAILS=


# CORS dan pembatasan permintaan
#
# Aplikasi Flutter tidak mengirim header Origin sehingga tidak terpengaruh
# pengaturan CORS. Nilai "*" ditolak ketika NODE_ENV=production.
CORS_ORIGINS=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10


# Khusus pengembangan
#
# Mengaktifkan POST /api/auth/dev-login yang menerbitkan kunci akses untuk akun
# hasil seed tanpa melalui Google. Berguna untuk menguji API sebelum konfigurasi
# Google siap.
#
# Jalur ini tidak pernah aktif ketika NODE_ENV=production, apa pun isi variabel
# ini, dan tidak pernah membuat akun baru.
ENABLE_DEV_LOGIN=false
