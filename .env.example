# Konfigurasi Kantin ITK. Salin menjadi .env lalu sesuaikan nilainya.
#
#   cp .env.example .env


# Aplikasi
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Diisi true hanya bila server berada di belakang reverse proxy.
TRUST_PROXY=false


# Database MySQL. DATABASE_URL diabaikan bila skemanya bukan mysql://
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/kantin_itk
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kantin_itk
DB_CONNECTION_LIMIT=10


# Kunci akses. JWT_SECRET minimal 32 karakter, dibuat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=kantin-itk-api


# Google SSO. Diisi client ID bertipe "Web application", bukan Android, karena
# nilai itulah yang menjadi klaim aud pada idToken kiriman aplikasi.
# Client secret tidak dibutuhkan. Wajib diisi ketika NODE_ENV=production.
GOOGLE_CLIENT_ID=


# Domain email yang boleh dipakai pembeli.
ALLOWED_EMAIL_DOMAINS=student.itk.ac.id,lecture.itk.ac.id,itk.ac.id

# Email penjual, dipisahkan koma tanpa spasi. Diisi sendiri, lepas dari seed.
# Menambah alamat cukup diikuti menjalankan ulang server, tanpa migrasi.
# Peran menyesuaikan saat pemiliknya masuk berikutnya, berlaku dua arah.
SELLER_EMAILS=


# CORS dan pembatasan permintaan. Nilai "*" ditolak saat NODE_ENV=production.
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10


# Firebase Cloud Messaging untuk pesan push.
# Diisi jalur berkas kredensial akun layanan. Bila dikosongkan, riwayat
# notifikasi tetap tersimpan namun pesan push tidak dikirim.
FIREBASE_SERVICE_ACCOUNT=


# Menyalakan POST /api/auth/dev-login. Tidak pernah aktif di produksi.
ENABLE_DEV_LOGIN=false
